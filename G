_LOCK = threading.RLock()


def _p(name):
    return os.path.join(DATA_DIR, name + ".json")


def _r(name, default):
    try:
        with open(_p(name), "r", encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return default


def _w(name, data):
    tmp = _p(name) + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
    os.replace(tmp, _p(name))


def next_id(prefix):
    with _LOCK:
        seq = _r("_seq", {})
        seq[prefix] = int(seq.get(prefix, 0)) + 1
        _w("_seq", seq)
        return "%s-%04d" % (prefix, seq[prefix])


def make_key():
    seg = lambda n: "".join(random.choice(KEY_CHARS) for _ in range(n))
    return "-".join(["INTL", seg(4), seg(4), seg(4), seg(4)])


