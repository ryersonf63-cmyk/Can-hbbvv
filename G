@app.route("/api/run/<slug>", methods=["POST"])
@login_required
def api_run(slug):
    spec = MODULES.get(slug)
    if not spec:
        return jsonify({"success": False, "error": "unknown module: %s" % slug}), 404
    me = current_member()
    form = request.get_json(silent=True) or {}
    t0 = time.time()
    try:
        result = execute(spec, form)
    except requests.exceptions.Timeout:
        return jsonify({"success": False, "module": slug, "error": "upstream timeout"})
    except requests.exceptions.RequestException as e:
        return jsonify({"success": False, "module": slug, "error": "network error: %s" % e})
    except Exception as e:
        return jsonify({"success": False, "module": slug, "error": "%s: %s" % (type(e).__name__, e)})
    result["module"] = slug
    result["label"] = spec["label"]
    result["duration_ms"] = int((time.time() - t0) * 1000)
    result["fetched_at"] = now()
    log(me, "query.run", "%s :: %s" % (spec["label"], json.dumps(form, default=str)[:300]),
        slug, "query")
    return jsonify(result)


@app.route("/api/run-batch", methods=["POST"])
@login_required
def api_run_batch():
    jobs = (request.get_json(silent=True) or {}).get("jobs", [])[:24]
    me = current_member()
    out = []
    for job in jobs:
        slug = job.get("slug")
        spec = MODULES.get(slug)
        if not spec:
            out.append({"slug": slug, "success": False, "error": "unknown module"})
            continue
        t0 = time.time()
        try:
            res = execute(spec, job.get("form") or {})
        except Exception as e:
            res = {"success": False, "error": "%s: %s" % (type(e).__name__, e)}
        res.update({"slug": slug, "label": spec["label"],
                    "duration_ms": int((time.time() - t0) * 1000)})
        out.append(res)
    log(me, "query.batch", "%d modules fired" % len(jobs), "", "query")
    return jsonify({"success": True, "results": out})


