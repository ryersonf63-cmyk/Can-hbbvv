def _parse_sse(text):
    events, cur, buf = [], None, []
    for line in text.splitlines():
        if line.startswith("event:"):
            cur = line[6:].strip()
        elif line.startswith("data:"):
            buf.append(line[5:].strip())
        elif line.strip() == "" and buf:
            raw = "\n".join(buf)
            try:
                payload = json.loads(raw)
            except Exception:
                payload = raw
            events.append({"event": cur or "message", "data": payload})
            cur, buf = None, []
    if buf:
        raw = "\n".join(buf)
        try:
            payload = json.loads(raw)
        except Exception:
            payload = raw
        events.append({"event": cur or "message", "data": payload})
    return events


def _fetch_media(url):
    if not url:
        raise ValueError("image url required")
    if url.startswith("data:"):
        import base64
        head, b64 = url.split(",", 1)
        ctype = head.split(";")[0].replace("data:", "") or "image/jpeg"
        return "upload." + (ctype.split("/")[-1] or "jpg"), base64.b64decode(b64), ctype
    r = requests.get(url, timeout=45, headers={"User-Agent": "INTELSEC/1.0"})
    r.raise_for_status()
    ctype = r.headers.get("content-type", "image/jpeg").split(";")[0]
    name = url.split("?")[0].rstrip("/").rsplit("/", 1)[-1] or "upload.jpg"
    return name, r.content, ctype


def _build_payload(api, form):
    payload = dict(api.get("consts") or {})
    for src, dst in (api.get("map") or {}).items():
        v = form.get(src)
        if v not in (None, ""):
            payload[dst] = v
    for dst, srcs in (api.get("pick") or {}).items():
        for s in srcs:
            v = form.get(s)
            if v not in (None, ""):
                payload[dst] = v
                break
    for dst, srcs in (api.get("combine") or {}).items():
        parts = [str(form.get(s)).strip() for s in srcs if form.get(s)]
        if parts:
            payload[dst] = " ".join(parts)
    return payload


def _transform_celltower(payload, form):
    raw = re.sub(r"[^0-9\-]", "", str(form.get("cellid", "")))
    parts = [p for p in raw.split("-") if p]
    if len(parts) >= 4:
        payload.update({"mcc": int(parts[0]), "mnc": int(parts[1]),
                        "cellId": int(parts[2]), "tacId": int(parts[3]), "maxResults": 10})
    elif len(parts) == 1:
        payload["cellId"] = int(parts[0])
    return payload


TRANSFORMS = {"celltower": _transform_celltower}


def _wrap(r, provider, sse=False):
    ctype = r.headers.get("content-type", "")
    text = r.text
    out = {"success": r.ok, "provider": provider, "status": r.status_code}
    if "event-stream" in ctype or (sse and text.lstrip().startswith(("event:", "data:"))):
        events = _parse_sse(text)
        out["events"] = events
        out["event_count"] = len(events)
        if events:
            out["data"] = events[-1]["data"]
        return out
    try:
        out["data"] = r.json()
        if isinstance(out["data"], dict) and out["data"].get("success") is False:
            out["success"] = False
    except Exception:
        out["raw"] = text[:200000]
        if not r.ok:
            out["success"] = False
    if not r.ok:
        out["error"] = "upstream returned HTTP %d" % r.status_code
        if isinstance(out.get("data"), dict):
            out["error"] = out["data"].get("error") or out["error"]
    return out


def execute(spec, form):
    api = spec["api"]
    provider, path, kind = api["provider"], api["path"], api["kind"]

    if provider == "numlookup":
        phone = re.sub(r"[^\d+]", "", str(form.get(api.get("phone_field", "phone"), "")))
        if not phone:
            return {"success": False, "error": "phone number required"}
        r = requests.get(NUMLOOKUP_BASE + path.replace("{phone}", phone),
                         headers={"apikey": NUMLOOKUP_API_KEY}, timeout=UPSTREAM_TIMEOUT)
        return _wrap(r, "numlookup")

    if provider == "emailosint":
        payload = _build_payload(api, form)
        r = requests.post(EMAILOSINT_BASE + path, json=payload, timeout=UPSTREAM_TIMEOUT,
                          headers={"Authorization": "Bearer " + EMAILOSINT_API_KEY,
                                   "Content-Type": "application/json"})
        return _wrap(r, "emailosint")

    headers = {"x-api-key": INDICIA_API_KEY}
    url = INDICIA_BASE + path

    if api["method"] == "get":
        return _wrap(requests.get(url, headers=headers, timeout=UPSTREAM_TIMEOUT), "indicia")

    if kind == "file":
        src = form.get("image_b64") or form.get("image") or ""
        name, content, ctype = _fetch_media(src)
        data = _build_payload(api, form)
        r = requests.post(url, headers=headers, files={"media": (name, io.BytesIO(content), ctype)},
                          data=data, timeout=UPSTREAM_TIMEOUT)
        return _wrap(r, "indicia", sse=True)

    payload = _build_payload(api, form)
    if api.get("transform"):
        payload = TRANSFORMS[api["transform"]](payload, form)
    if not payload:
        return {"success": False, "error": "no input provided"}

    r = requests.post(url, json=payload,
                      headers=dict(headers, **{"Content-Type": "application/json"}),
                      timeout=UPSTREAM_TIMEOUT)
    return _wrap(r, "indicia", sse=(kind == "sse"))


