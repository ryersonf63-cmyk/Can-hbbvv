def members_all():
    return list(_r("members", {}).values())


def member_get(mid):
    return _r("members", {}).get(mid)


def member_by_username(username):
    if not username:
        return None
    low = username.strip().lower()
    for m in members_all():
        if m["username"].lower() == low:
            return m
    return None


def member_by_key(key):
    if not key:
        return None
    k = key.strip().upper()
    for m in members_all():
        if m.get("key", "").upper() == k:
            return m
    return None


def member_create(username, role="member", key=None, title="", email=""):
    username = (username or "").strip()
    if not USERNAME_RE.match(username):
        raise ValueError("Username must be 3-20 chars: letters, numbers, . _ -")
    if member_by_username(username):
        raise ValueError("Username '%s' is already taken" % username)
    with _LOCK:
        members = _r("members", {})
        mid = next_id("MBR")
        m = {
            "id": mid, "username": username, "display": username, "role": role,
            "title": title, "email": email, "key": (key or make_key()).upper(),
            "status": "active", "created_at": now(), "last_login": None,
            "login_count": 0, "logins": [], "last_ip": "", "notes": "",
        }
        members[mid] = m
        _w("members", members)
        return m


def member_update(mid, **fields):
    with _LOCK:
        members = _r("members", {})
        m = members.get(mid)
        if not m:
            return None
        for k, v in fields.items():
            if v is not None:
                m[k] = v
        _w("members", members)
        return m


def member_touch_login(m):
    ip = request.headers.get("X-Forwarded-For", request.remote_addr or "").split(",")[0].strip()
    with _LOCK:
        members = _r("members", {})
        mm = members.get(m["id"])
        if not mm:
            return
        mm["last_login"] = now()
        mm["login_count"] = int(mm.get("login_count", 0)) + 1
        mm["last_ip"] = ip
        mm.setdefault("logins", []).append({
            "ts": now(), "ip": ip,
            "ua": (request.headers.get("User-Agent", "") or "")[:150],
        })
        mm["logins"] = mm["logins"][-60:]
        _w("members", members)


