@app.route("/api/signup", methods=["POST"])
def api_signup():
    d = request.get_json(silent=True) or {}
    username = (d.get("username") or "").strip()
    email = (d.get("email") or "").strip()
    if not USERNAME_RE.match(username):
        return jsonify({"success": False, "error":
                        "Username must be 3-20 characters (letters, numbers, . _ -)"}), 400
    if member_by_username(username):
        return jsonify({"success": False, "error": "Username '%s' is already taken" % username}), 409
    try:
        m = member_create(username, "member", email=email)
    except ValueError as e:
        return jsonify({"success": False, "error": str(e)}), 400
    log(m, "member.signup", "New member registered", m["id"], "auth")
    session["mid"] = m["id"]
    session.permanent = True
    member_touch_login(m)
    log(m, "auth.login", "First login", m["id"], "auth")
    return jsonify({"success": True, "key": m["key"], "member": member_full(m, True)})


@app.route("/api/signin", methods=["POST"])
def api_signin():
    d = request.get_json(silent=True) or {}
    key = (d.get("key") or "").strip().upper()
    if not KEY_RE.match(key):
        return jsonify({"success": False, "error": "Malformed key — expected INTL-XXXX-XXXX-XXXX-XXXX"}), 400
    m = member_by_key(key)
    if not m:
        return jsonify({"success": False, "error": "No member is bound to that key"}), 401
    if m.get("status") == "banned":
        return jsonify({"success": False, "error": "Account is suspended"}), 403
    session["mid"] = m["id"]
    session.permanent = True
    member_touch_login(m)
    log(m, "auth.login", "Signed in", m["id"], "auth")
    return jsonify({"success": True, "member": member_full(m, True)})


