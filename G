def ticket_create(member, subject, body, category="general", priority="normal"):
    tid = next_id("TKT")
    t = {
        "id": tid, "member_id": member["id"], "username": member["username"],
        "role": member.get("role"), "subject": subject.strip()[:160] or "(no subject)",
        "category": category if category in TICKET_CATEGORY else "general",
        "priority": priority if priority in TICKET_PRIORITY else "normal",
        "status": "open", "needs_human": False, "assigned_to": None, "ai_topics": [],
        "created_at": now(), "updated_at": now(),
        "messages": [{"id": next_id("MSG"), "author": "member", "name": member["username"],
                      "role": member.get("role"), "body": body.strip()[:6000], "ts": now()}],
    }
    ticket_save(t)
    ticket_ai_reply(tid)
    return t


def ticket_add_message(tid, author, name, role, body, meta=None):
    t = ticket_get(tid)
    if not t:
        return None
    t["messages"].append({"id": next_id("MSG"), "author": author, "name": name, "role": role,
                          "body": body, "ts": now(), "meta": meta or {}})
    t["updated_at"] = now()
    if author == "staff":
        t["status"] = "answered"
        t["needs_human"] = False
    elif author == "member" and t["status"] in ("resolved", "closed"):
        t["status"] = "open"
    ticket_save(t)
    return t


def ticket_ai_reply(tid):
    t = ticket_get(tid)
    if not t:
        return None
    member = member_get(t["member_id"]) or {"id": t["member_id"], "username": t["username"],
                                            "role": t.get("role")}
    body, topic, needs_human = ai_compose_reply(t, member)
    upgrade = ai_llm([{"role": "system", "content": ai_system_prompt(member)}] +
                     [{"role": "assistant" if m["author"] == "ai" else "user", "content": m["body"]}
                      for m in t["messages"][-6:]])
    if upgrade:
        body = upgrade
    t["messages"].append({"id": next_id("MSG"), "author": "ai",
                          "name": SITE_NAME + " Assistant", "role": "ai", "body": body, "ts": now(),
                          "meta": {"topic": topic, "needs_human": needs_human, "llm": bool(upgrade)}})
    t["ai_topics"] = sorted(set(t.get("ai_topics", []) + [topic]))
    t["needs_human"] = needs_human
    t["status"] = "pending" if needs_human else "answered"
    t["updated_at"] = now()
    ticket_save(t)
    return t


def ticket_staff_has_replied(t):
    return any(m.get("author") == "staff" for m in t.get("messages", []))


