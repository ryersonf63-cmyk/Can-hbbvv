def login_required(fn):
    @wraps(fn)
    def inner(*a, **kw):
        if not current_member():
            return jsonify({"success": False, "error": "not authenticated"}), 401
        return fn(*a, **kw)
    return inner


def staff_required(fn):
    @wraps(fn)
    def inner(*a, **kw):
        me = current_member()
        if not me:
            return jsonify({"success": False, "error": "not authenticated"}), 401
        if not is_staff(me.get("role")):
            return jsonify({"success": False, "error": "staff only"}), 403
        return fn(*a, **kw)
    return inner


