def log(actor, action, detail="", target="", kind="info"):
    with _LOCK:
        entries = _r("audit", [])
        entries.append({
            "id": next_id("LOG"),
            "ts": now(),
            "actor_id": (actor or {}).get("id", "SYSTEM"),
            "actor": (actor or {}).get("username", "system"),
            "actor_role": (actor or {}).get("role", "system"),
            "action": action,
            "target": target,
            "detail": detail if isinstance(detail, str) else json.dumps(detail, default=str),
            "kind": kind,
            "ip": request.headers.get("X-Forwarded-For", request.remote_addr or "").split(",")[0].strip()
                  if request else "",
        })
        if len(entries) > 10000:
            entries = entries[-10000:]
        _w("audit", entries)


def audit_read(limit=300, actor=None, kind=None, q=None):
    entries = list(reversed(_r("audit", [])))
    if actor:
        entries = [e for e in entries if e.get("actor") == actor]
    if kind:
        entries = [e for e in entries if e.get("kind") == kind]
    if q:
        ql = q.lower()
        entries = [e for e in entries
                   if ql in (e.get("action", "") + e.get("detail", "") + e.get("actor", "")).lower()]
    return entries[:limit]


