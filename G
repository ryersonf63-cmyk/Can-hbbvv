def _kb_score(text, keys):
    t = text.lower()
    return sum(t.count(k) for k in keys)


def ai_compose_reply(ticket, member):
    blob = " ".join([ticket.get("subject", ""), ticket.get("category", "")] +
                    [m.get("body", "") for m in ticket.get("messages", []) if m.get("author") == "member"])
    best, score = None, 0
    for keys, title, answer in KB:
        s = _kb_score(blob, keys)
        if s > score:
            best, score = (title, answer), s
    urgent = ticket.get("priority") in ("high", "urgent")
    if best and score >= 1:
        topic, answer = best
        needs_human = score < 2 or urgent
    else:
        topic, answer, needs_human = "General", AI_FALLBACK, True

    staff = [m["username"] for m in members_all() if is_staff(m.get("role"))]
    mine = [t for t in tickets_all() if t.get("member_id") == member["id"]]
    open_mine = [t for t in mine if t.get("status") not in ("resolved", "closed")]

    lines = [
        "Hi %s," % member["username"], "",
        "This is the %s automated first-line desk. Topic matched: %s." % (SITE_NAME, topic), "",
        answer, "", "---",
        "Role: %s  |  Your open tickets: %d  |  Priority: %s"
        % (role_meta(member.get("role"))["label"], len(open_mine), ticket.get("priority", "normal")),
    ]
    if needs_human:
        lines += ["", "Status: QUEUED FOR HUMAN REVIEW. Staff (%s) have been notified."
                  % ", ".join(staff[:4])]
    else:
        lines += ["", "If this did not solve it, reply here and a human will pick it up."]
    lines += ["", "— %s Assistant" % SITE_NAME]
    return "\n".join(lines), topic, needs_human


def ai_llm(messages):
    if not AI_BASE_URL or not AI_API_KEY:
        return None
    try:
        r = requests.post(AI_BASE_URL + "/chat/completions",
                          headers={"Authorization": "Bearer " + AI_API_KEY,
                                   "Content-Type": "application/json"},
                          json={"model": AI_MODEL, "messages": messages,
                                "temperature": 0.4, "max_tokens": 700}, timeout=45)
        r.raise_for_status()
        return r.json()["choices"][0]["message"]["content"].strip()
    except Exception:
        return None


